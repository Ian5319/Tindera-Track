rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // User lookup is needed before Firebase Authentication sign-in when the
    // owner enters a name or phone number instead of an email address.
    match /users/{userId} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // The authenticated owner manages all existing store data. There are no
    // customer, staff, or payment-management roles in this application.
    match /products/{documentId} {
      allow read, write: if signedIn();
    }

    match /customers/{documentId} {
      allow read, write: if signedIn();
    }

    match /utang_transactions/{documentId} {
      allow read, write: if signedIn();
    }

    // Payments are stored separately from Utang transactions.
    match /payment_records/{paymentId} {
      allow read, write: if signedIn();
    }

    match /sales/{saleId} {
      allow read, write: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
