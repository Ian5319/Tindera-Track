rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owned(data) {
      return signedIn()
        && data.ownerId is string
        && data.ownerId == request.auth.uid;
    }

    function validId(value) {
      return value is string && value.size() > 0 && value.size() <= 128;
    }

    function validText(value, minimum, maximum) {
      return value is string
        && value.size() >= minimum
        && value.size() <= maximum;
    }

    function optionalText(value, maximum) {
      return value == null || (value is string && value.size() <= maximum);
    }

    function optionalHttpsUrl(value) {
      return value == null
        || (value is string
          && value.size() <= 2048
          && value.matches('https://.*'));
    }

    function validProduct(productId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id', 'ownerId', 'name', 'price', 'stockQuantity', 'photoUrl',
          'threshold', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'name', 'price', 'stockQuantity', 'photoUrl',
          'threshold', 'createdAt', 'updatedAt'
        ])
        && data.id == productId
        && data.ownerId == request.auth.uid
        && validText(data.name, 1, 200)
        && data.price is number
        && data.price > 0
        && data.price <= 1000000000000
        && data.stockQuantity is int
        && data.stockQuantity >= 0
        && data.stockQuantity <= 1000000000
        && data.threshold is int
        && data.threshold >= 0
        && data.threshold <= 1000000000
        && optionalHttpsUrl(data.photoUrl)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdAt <= request.time
        && data.updatedAt <= request.time;
    }

    function validCustomer(customerId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id', 'ownerId', 'name', 'phone', 'balance', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'name', 'phone', 'balance', 'createdAt', 'updatedAt'
        ])
        && data.id == customerId
        && data.ownerId == request.auth.uid
        && validText(data.name, 1, 200)
        && validText(data.phone, 0, 32)
        && data.balance is number
        && data.balance >= 0
        && data.balance <= 1000000000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdAt <= request.time
        && data.updatedAt <= request.time;
    }

    function validTransaction(transactionId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id', 'ownerId', 'customerId', 'amount', 'type', 'photoUrl', 'note',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'customerId', 'amount', 'type', 'photoUrl', 'note',
          'createdAt'
        ])
        && data.id == transactionId
        && data.ownerId == request.auth.uid
        && validId(data.customerId)
        && data.amount is number
        && data.amount > 0
        && data.amount <= 1000000000000
        && (data.type == 'credit' || data.type == 'payment')
        && optionalHttpsUrl(data.photoUrl)
        && optionalText(data.note, 2000)
        && data.createdAt is timestamp
        && data.createdAt <= request.time;
    }

    function validSale(saleId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id', 'ownerId', 'productId', 'productName', 'quantity',
          'sellingPrice', 'totalAmount', 'soldAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'productId', 'productName', 'quantity',
          'sellingPrice', 'totalAmount', 'soldAt'
        ])
        && data.id == saleId
        && data.ownerId == request.auth.uid
        && validId(data.productId)
        && validText(data.productName, 1, 200)
        && data.quantity is int
        && data.quantity > 0
        && data.quantity <= 1000000000
        && data.sellingPrice is number
        && data.sellingPrice > 0
        && data.sellingPrice <= 1000000000000
        && data.totalAmount is number
        && data.totalAmount == data.sellingPrice * data.quantity
        && data.totalAmount <= 1000000000000
        && data.soldAt is timestamp
        && data.soldAt <= request.time;
    }

    function validPayment(paymentId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id', 'ownerId', 'customerId', 'customerName', 'utangId', 'amount',
          'paymentDate', 'note', 'recordedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'customerId', 'customerName', 'utangId', 'amount',
          'paymentDate', 'note', 'recordedBy', 'createdAt', 'updatedAt'
        ])
        && data.id == paymentId
        && data.ownerId == request.auth.uid
        && validId(data.customerId)
        && validText(data.customerName, 1, 200)
        && data.utangId == data.customerId
        && data.amount is number
        && data.amount > 0
        && data.amount <= 1000000000000
        && data.paymentDate is timestamp
        && data.paymentDate <= request.time
        && optionalText(data.note, 2000)
        && data.recordedBy == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdAt <= request.time
        && data.updatedAt <= request.time;
    }

    function ownedCustomer(customerId) {
      return signedIn()
        && exists(/databases/$(database)/documents/customers/$(customerId))
        && get(/databases/$(database)/documents/customers/$(customerId)).data.ownerId
            == request.auth.uid;
    }

    function ownedProduct(productId) {
      return signedIn()
        && exists(/databases/$(database)/documents/products/$(productId))
        && get(/databases/$(database)/documents/products/$(productId)).data.ownerId
            == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'id', 'name', 'nameLowercase', 'email', 'phone', 'storeName', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'nameLowercase', 'email', 'phone', 'storeName', 'createdAt'
        ])
        && request.resource.data.id == userId
        && validText(request.resource.data.name, 1, 100)
        && validText(request.resource.data.nameLowercase, 1, 100)
        && validText(request.resource.data.email, 3, 320)
        && request.resource.data.email == request.auth.token.email
        && validText(request.resource.data.phone, 0, 32)
        && validText(request.resource.data.storeName, 1, 160)
        && request.resource.data.createdAt is timestamp;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'id', 'name', 'nameLowercase', 'email', 'phone', 'storeName', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'nameLowercase', 'email', 'phone', 'storeName', 'createdAt'
        ])
        && request.resource.data.id == resource.data.id
        && validText(request.resource.data.name, 1, 100)
        && validText(request.resource.data.nameLowercase, 1, 100)
        && request.resource.data.email == resource.data.email
        && validText(request.resource.data.phone, 0, 32)
        && validText(request.resource.data.storeName, 1, 160)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if owned(resource.data);
      allow create: if signedIn() && validProduct(productId);
      allow update: if owned(resource.data)
        && validProduct(productId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if owned(resource.data);
    }

    match /customers/{customerId} {
      allow read: if owned(resource.data);
      allow create: if signedIn()
        && validCustomer(customerId)
        && request.resource.data.balance == 0;
      allow update: if owned(resource.data)
        && validCustomer(customerId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.balance == resource.data.balance;
      allow delete: if owned(resource.data);
    }

    match /utang_transactions/{transactionId} {
      allow read: if owned(resource.data);
      allow create: if signedIn()
        && validTransaction(transactionId)
        && ownedCustomer(request.resource.data.customerId);
      allow update, delete: if false;
    }

    match /payment_records/{paymentId} {
      allow read: if owned(resource.data);
      allow create: if signedIn()
        && validPayment(paymentId)
        && ownedCustomer(request.resource.data.customerId);
      allow update: if owned(resource.data)
        && validPayment(paymentId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.customerName == resource.data.customerName
        && request.resource.data.utangId == resource.data.utangId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.recordedBy == resource.data.recordedBy
        && ownedCustomer(request.resource.data.customerId);
      allow delete: if owned(resource.data);
    }

    match /sales/{saleId} {
      allow read: if owned(resource.data);
      allow create: if signedIn()
        && validSale(saleId)
        && ownedProduct(request.resource.data.productId);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
