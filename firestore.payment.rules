rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validPaymentDocument(paymentId) {
      return request.resource.data.keys().hasOnly([
          'id',
          'customerId',
          'customerName',
          'utangId',
          'amount',
          'paymentDate',
          'note',
          'recordedBy',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.id == paymentId
        && request.resource.data.customerId is string
        && request.resource.data.customerName is string
        && (request.resource.data.utangId == null
            || request.resource.data.utangId is string)
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.paymentDate is timestamp
        && (request.resource.data.note == null
            || request.resource.data.note is string)
        && request.resource.data.recordedBy is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /payment_records/{paymentId} {
      allow create: if signedIn() && validPaymentDocument(paymentId);
      // This is an owner-only app: an authenticated owner may read the
      // payment collection. There are no customer/staff roles to check.
      // Keeping the read rule at the collection level also allows the
      // idempotency transaction to check a not-yet-created document.
      allow read: if signedIn();

      allow update: if signedIn()
        && validPaymentDocument(paymentId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.customerName == resource.data.customerName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.recordedBy == resource.data.recordedBy;
      allow delete: if signedIn();
    }

    // This is a dedicated payment-project rules file. Any collection other
    // than payment_records is denied in the payment backend.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
