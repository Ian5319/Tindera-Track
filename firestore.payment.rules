rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owned(data) {
      return signedIn()
        && data.ownerId is string
        && data.ownerId == request.auth.uid;
    }

    function ownedCustomer(customerId) {
      return signedIn()
        && exists(/databases/$(database)/documents/customers/$(customerId))
        && get(/databases/$(database)/documents/customers/$(customerId)).data.ownerId
            == request.auth.uid;
    }

    function validPayment(paymentId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id', 'ownerId', 'customerId', 'customerName', 'utangId', 'amount',
          'paymentDate', 'note', 'recordedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'customerId', 'customerName', 'utangId', 'amount',
          'paymentDate', 'note', 'recordedBy', 'createdAt', 'updatedAt'
        ])
        && data.id == paymentId
        && data.ownerId == request.auth.uid
        && data.customerId is string
        && data.customerId.size() > 0
        && data.customerName is string
        && data.customerName.size() > 0
        && data.customerName.size() <= 200
        && data.utangId == data.customerId
        && data.amount is number
        && data.amount > 0
        && data.amount <= 1000000000000
        && data.paymentDate is timestamp
        && data.paymentDate <= request.time
        && (data.note == null || (data.note is string && data.note.size() <= 2000))
        && data.recordedBy == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdAt <= request.time
        && data.updatedAt <= request.time;
    }

    match /payment_records/{paymentId} {
      // Allow the idempotency transaction to read a missing payment document.
      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/payment_records/$(paymentId))
            || owned(resource.data));
      allow list: if owned(resource.data);
      allow create: if signedIn()
        && validPayment(paymentId)
        && ownedCustomer(request.resource.data.customerId);
      allow update: if owned(resource.data)
        && validPayment(paymentId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.recordedBy == resource.data.recordedBy
        && ownedCustomer(request.resource.data.customerId);
      allow delete: if owned(resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
