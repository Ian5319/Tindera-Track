[debug] [2026-10-25T22:48:30.350Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/tinderatrack-acf1a/rulesets {"name":"projects/tinderatrack-acf1a/rulesets/1983ee0e-e921-414a-a299-e33dc0632c17","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function owned(data) {\n      return signedIn()\n        && data.ownerId is string\n        && data.ownerId == request.auth.uid;\n    }\n\n    function validId(value) {\n      return value is string && value.size() > 0 && value.size() <= 128;\n    }\n\n    function validText(value, minimum, maximum) {\n      return value is string\n        && value.size() >= minimum\n        && value.size() <= maximum;\n    }\n\n    function optionalText(value, maximum) {\n      return value == null || (value is string && value.size() <= maximum);\n    }\n\n    function optionalHttpsUrl(value) {\n      return value == null\n        || (value is string\n          && value.size() <= 2048\n          && value.matches('https://.*'));\n    }\n\n    function validProduct(productId) {\n      let data = request.resource.data;\n      return data.keys().hasAll([\n          'id', 'ownerId', 'name', 'price', 'stockQuantity', 'photoUrl',\n          'threshold', 'createdAt', 'updatedAt'\n        ])\n        && data.keys().hasOnly([\n          'id', 'ownerId', 'name', 'price', 'stockQuantity', 'photoUrl',\n          'threshold', 'createdAt', 'updatedAt'\n        ])\n        && data.id == productId\n        && data.ownerId == request.auth.uid\n        && validText(data.name, 1, 200)\n        && data.price is number\n        && data.price > 0\n        && data.price <= 1000000000000\n        && data.stockQuantity is int\n        && data.stockQuantity >= 0\n        && data.stockQuantity <= 1000000000\n        && data.threshold is int\n        && data.threshold >= 0\n        && data.threshold <= 1000000000\n        && optionalHttpsUrl(data.photoUrl)\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp\n        && data.createdAt <= request.time\n        && data.updatedAt <= request.time;\n    }\n\n    function validCustomer(customerId) {\n      let data = request.resource.data;\n      return data.keys().hasAll([\n          'id', 'ownerId', 'name', 'phone', 'balance', 'createdAt', 'updatedAt'\n        ])\n        && data.keys().hasOnly([\n          'id', 'ownerId', 'name', 'phone', 'balance', 'createdAt', 'updatedAt'\n        ])\n        && data.id == customerId\n        && data.ownerId == request.auth.uid\n        && validText(data.name, 1, 200)\n        && validText(data.phone, 0, 32)\n        && data.balance is number\n        && data.balance >= 0\n        && data.balance <= 1000000000000\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp\n        && data.createdAt <= request.time\n        && data.updatedAt <= request.time;\n    }\n\n    function validTransaction(transactionId) {\n      let data = request.resource.data;\n      return data.keys().hasAll([\n          'id', 'ownerId', 'customerId', 'amount', 'type', 'photoUrl', 'note',\n          'createdAt'\n        ])\n        && data.keys().hasOnly([\n          'id', 'ownerId', 'customerId', 'amount', 'type', 'photoUrl', 'note',\n          'createdAt'\n        ])\n        && data.id == transactionId\n        && data.ownerId == request.auth.uid\n        && validId(data.customerId)\n        && data.amount is number\n        && data.amount > 0\n        && data.amount <= 1000000000000\n        && (data.type == 'credit' || data.type == 'payment')\n        && optionalHttpsUrl(data.photoUrl)\n        && optionalText(data.note, 2000)\n        && data.createdAt is timestamp\n        && data.createdAt <= request.time;\n    }\n\n    function validSale(saleId) {\n      let data = request.resource.data;\n      return data.keys().hasAll([\n          'id', 'ownerId', 'productId', 'productName', 'quantity',\n          'sellingPrice', 'totalAmount', 'soldAt'\n        ])\n        && data.keys().hasOnly([\n          'id', 'ownerId', 'productId', 'productName', 'quantity',\n          'sellingPrice', 'totalAmount', 'soldAt'\n        ])\n        && data.id == saleId\n        && data.ownerId == request.auth.uid\n        && validId(data.productId)\n        && validText(data.productName, 1, 200)\n        && data.quantity is int\n        && data.quantity > 0\n        && data.quantity <= 1000000000\n        && data.sellingPrice is number\n        && data.sellingPrice > 0\n        && data.sellingPrice <= 1000000000000\n        && data.totalAmount is number\n        && data.totalAmount == data.sellingPrice * data.quantity\n        && data.totalAmount <= 1000000000000\n        && data.soldAt is timestamp\n        && data.soldAt <= request.time;\n    }\n\n    function validPayment(paymentId) {\n      let data = request.resource.data;\n      return data.keys().hasAll([\n          'id', 'ownerId', 'customerId', 'customerName', 'utangId', 'amount',\n          'paymentDate', 'note', 'recordedBy', 'createdAt', 'updatedAt'\n        ])\n        && data.keys().hasOnly([\n          'id', 'ownerId', 'customerId', 'customerName', 'utangId', 'amount',\n          'paymentDate', 'note', 'recordedBy', 'createdAt', 'updatedAt'\n        ])\n        && data.id == paymentId\n        && data.ownerId == request.auth.uid\n        && validId(data.customerId)\n        && validText(data.customerName, 1, 200)\n        && data.utangId == data.customerId\n        && data.amount is number\n        && data.amount > 0\n        && data.amount <= 1000000000000\n        && data.paymentDate is timestamp\n        && data.paymentDate <= request.time\n        && optionalText(data.note, 2000)\n        && data.recordedBy == request.auth.uid\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp\n        && data.createdAt <= request.time\n        && data.updatedAt <= request.time;\n    }\n\n    function ownedCustomer(customerId) {\n      return signedIn()\n        && exists(/databases/$(database)/documents/customers/$(customerId))\n        && get(/databases/$(database)/documents/customers/$(customerId)).data.ownerId\n            == request.auth.uid;\n    }\n\n    function ownedProduct(productId) {\n      return signedIn()\n        && exists(/databases/$(database)/documents/products/$(productId))\n        && get(/databases/$(database)/documents/products/$(productId)).data.ownerId\n            == request.auth.uid;\n    }\n\n    match /users/{userId} {\n      allow read: if signedIn() && request.auth.uid == userId;\n      allow create: if signedIn()\n        && request.auth.uid == userId\n        && request.resource.data.keys().hasAll([\n          'id', 'name', 'nameLowercase', 'email', 'phone', 'storeName', 'createdAt'\n        ])\n        && request.resource.data.keys().hasOnly([\n          'id', 'name', 'nameLowercase', 'email', 'phone', 'storeName', 'createdAt'\n        ])\n        && request.resource.data.id == userId\n        && validText(request.resource.data.name, 1, 100)\n        && validText(request.resource.data.nameLowercase, 1, 100)\n        && validText(request.resource.data.email, 3, 320)\n        && request.resource.data.email == request.auth.token.email\n        && validText(request.resource.data.phone, 0, 32)\n        && validText(request.resource.data.storeName, 1, 160)\n        && request.resource.data.createdAt is timestamp;\n      allow update: if signedIn()\n        && request.auth.uid == userId\n        && request.resource.data.keys().hasAll([\n          'id', 'name', 'nameLowercase', 'email', 'phone', 'storeName', 'createdAt'\n        ])\n        && request.resource.data.keys().hasOnly([\n          'id', 'name', 'nameLowercase', 'email', 'phone', 'storeName', 'createdAt'\n        ])\n        && request.resource.data.id == resource.data.id\n        && validText(request.resource.data.name, 1, 100)\n        && validText(request.resource.data.nameLowercase, 1, 100)\n        && request.resource.data.email == resource.data.email\n        && validText(request.resource.data.phone, 0, 32)\n        && validText(request.resource.data.storeName, 1, 160)\n        && request.resource.data.createdAt == resource.data.createdAt;\n      allow delete: if false;\n    }\n\n    match /products/{productId} {\n      allow read: if owned(resource.data);\n      allow create: if signedIn() && validProduct(productId);\n      allow update: if owned(resource.data)\n        && validProduct(productId)\n        && request.resource.data.ownerId == resource.data.ownerId\n        && request.resource.data.createdAt == resource.data.createdAt;\n      allow delete: if owned(resource.data);\n    }\n\n    match /customers/{customerId} {\n      allow read: if owned(resource.data);\n      allow create: if signedIn()\n        && validCustomer(customerId)\n        && request.resource.data.balance == 0;\n      allow update: if owned(resource.data)\n        && validCustomer(customerId)\n        && request.resource.data.ownerId == resource.data.ownerId\n        && request.resource.data.createdAt == resource.data.createdAt\n        && request.resource.data.balance == resource.data.balance;\n      allow delete: if owned(resource.data);\n    }\n\n    match /utang_transactions/{transactionId} {\n      allow read: if owned(resource.data);\n      allow create: if signedIn()\n        && validTransaction(transactionId)\n        && ownedCustomer(request.resource.data.customerId);\n      allow update, delete: if false;\n    }\n\n    match /payment_records/{paymentId} {\n      allow read: if owned(resource.data);\n      allow create: if signedIn()\n        && validPayment(paymentId)\n        && ownedCustomer(request.resource.data.customerId);\n      allow update: if owned(resource.data)\n        && validPayment(paymentId)\n        && request.resource.data.ownerId == resource.data.ownerId\n        && request.resource.data.customerId == resource.data.customerId\n        && request.resource.data.customerName == resource.data.customerName\n        && request.resource.data.utangId == resource.data.utangId\n        && request.resource.data.createdAt == resource.data.createdAt\n        && request.resource.data.recordedBy == resource.data.recordedBy\n        && ownedCustomer(request.resource.data.customerId);\n      allow delete: if owned(resource.data);\n    }\n\n    match /sales/{saleId} {\n      allow read: if owned(resource.data);\n      allow create: if signedIn()\n        && validSale(saleId)\n        && ownedProduct(request.resource.data.productId);\n      allow update, delete: if false;\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-10-25T22:48:30.419119Z","metadata":{"services":["cloud.firestore"]}}
